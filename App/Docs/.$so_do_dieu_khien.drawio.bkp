        <mxCell id="n1" value="GHI CHU VE NHIP&lt;br&gt;8 kHz | ngat DRDY cua IMU, uu tien 0, nhanh nhat trong he&lt;br&gt;4 kHz | vong PID toc do goc, bam nhip theo sample_count cua IMU&lt;br&gt;1 kHz | vong goc, ba vong ngoai, EKF, va phat khung DShot&lt;br&gt;Vong lap chinh phai xong duoi 125 us = MOT chu ky mau IMU" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1020" height="110" as="geometry"/></mxCell>
        <mxCell id="n2" value="NGUYEN TAC THIET KE&lt;br&gt;Vong trong nhanh va manh, vong ngoai cham va hien | moi tang them mot luong tre&lt;br&gt;Moi vong ngoai deu co duong LUI: mat flow &#8594; ANGLE, mat do cao &#8594; ga tay, mat goc &#8594; ACRO&lt;br&gt;Khau tron hy sinh GA chu khong hy sinh quyen dieu khien tu the&lt;br&gt;Yaw khong co chuan tuyet doi (chua co tu ke) nen LUON dieu khien theo toc do" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1100" y="1140" width="1000" height="110" as="geometry"/></mxCell>
